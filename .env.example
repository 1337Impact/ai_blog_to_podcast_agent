# Neon Postgres (Vercel Marketplace: `vercel integration add neon`)
DATABASE_URL=

# Google OAuth (Auth.js). Create a Web client in Google Cloud Console.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Production: https://<your-domain>/api/auth/callback/google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Vercel Blob (created with `vercel blob store add`, token is auto-injected on Vercel)
BLOB_READ_WRITE_TOKEN=

# Podcast generation
FIRECRAWL_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
